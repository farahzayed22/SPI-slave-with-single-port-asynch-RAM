    rx_valid_reg,
    rx_valid_reg_0,
    Q,
    WEA,
    SR,
    \rx_data_reg[9] ,
    tx_busy_reg,
    E,
    rx_valid_reg_1);
  output [7:0]D;
  output tx_valid;
  output miso_reg;
  input CLK;
  input rstn_IBUF;
  input rx_valid_reg;
  input rx_valid_reg_0;
  input [7:0]Q;
  input [0:0]WEA;
  input [0:0]SR;
  input \rx_data_reg[9] ;
  input tx_busy_reg;
  input [0:0]E;
