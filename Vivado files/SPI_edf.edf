(* STRUCTURAL_NETLIST = "yes" *)
module SPI_wrapper
   (clk,
    rstn,
    mosi,
    miso,
    ss_n);
  input clk;
  input rstn;
  input mosi;
  output miso;
  input ss_n;

  wire clk;
  wire clk_IBUF;
  wire clk_IBUF_BUFG;
  wire mem;
  wire miso;
  wire miso_OBUF;
  wire mosi;
  wire mosi_IBUF;
  wire ram_n_9;
  wire rstn;
  wire rstn_IBUF;
  wire [7:0]rx_data;
  wire slave_n_1;
  wire slave_n_12;
  wire slave_n_14;
  wire slave_n_15;
  wire slave_n_16;
  wire slave_n_2;
  wire slave_n_3;
  wire ss_n;
  wire ss_n_IBUF;
  wire [7:0]tx_data;
  wire tx_valid;

  BUFG clk_IBUF_BUFG_inst
       (.I(clk_IBUF),
        .O(clk_IBUF_BUFG));
  IBUF clk_IBUF_inst
       (.I(clk),
        .O(clk_IBUF));
  OBUF miso_OBUF_inst
       (.I(miso_OBUF),
        .O(miso));
  IBUF mosi_IBUF_inst
       (.I(mosi),
        .O(mosi_IBUF));
  asynch_ram ram
       (.CLK(clk_IBUF_BUFG),
        .D(tx_data),
        .E(slave_n_14),
        .Q(rx_data),
        .SR(slave_n_1),
        .WEA(mem),
        .miso_reg(ram_n_9),
        .rstn_IBUF(rstn_IBUF),
        .\rx_data_reg[9] (slave_n_16),
        .rx_valid_reg(slave_n_3),
        .rx_valid_reg_0(slave_n_12),
        .rx_valid_reg_1(slave_n_15),
        .tx_busy_reg(slave_n_2),
        .tx_valid(tx_valid));
  IBUF rstn_IBUF_inst
       (.I(rstn),
        .O(rstn_IBUF));
  SPI_slave slave
       (.CLK(clk_IBUF_BUFG),
        .D(tx_data),
        .E(slave_n_14),
        .Q(rx_data),
        .SR(slave_n_1),
        .WEA(mem),
        .mem_reg(slave_n_3),
        .mem_reg_0(slave_n_12),
        .miso_OBUF(miso_OBUF),
        .mosi_IBUF(mosi_IBUF),
        .\rd_addr_reg[7] (slave_n_15),
        .rstn_IBUF(rstn_IBUF),
        .ss_n_IBUF(ss_n_IBUF),
        .tx_busy_reg_0(slave_n_2),
        .tx_valid(tx_valid),
        .tx_valid_reg(slave_n_16),
        .tx_valid_reg_0(ram_n_9));
  IBUF ss_n_IBUF_inst
       (.I(ss_n),
        .O(ss_n_IBUF));
endmodule

module asynch_ram
   (D,
